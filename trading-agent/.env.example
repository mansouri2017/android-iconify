# In n8n als Umgebungsvariablen setzen (Docker: -e, n8n.cloud: Settings > Variables)

# Frei waehlbares Geheimwort, das im TradingView-Alert-JSON als "secret" mitgeschickt wird.
# Verhindert, dass Fremde deinen Webhook mit falschen Signalen fuettern.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Telegram-Chat-ID, an die die Signale gesendet werden (deine eigene Chat-ID oder eine Gruppen-ID).
TELEGRAM_CHAT_ID=123456789

# Abstand von Take-Profit / Stop-Loss zum Entry-Preis, in Indexpunkten (US100/Nasdaq-100).
TP_POINTS=50
SL_POINTS=25
